{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "description": "The app's CLI: @marinoscar/platform-cli composed with this app's identity.",
  "type": "module",
  "bin": {
    "appctl": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@app/shared": "*",
    "@marinoscar/platform-cli": "^0.1.0-next.4",
    "@marinoscar/platform-infra": "^0.1.0-next.4",
    "commander": "^14.0.2",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.17",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
