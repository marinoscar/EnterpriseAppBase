{
  "name": "@marinoscar/platform-contract",
  "version": "0.1.0-next.3",
  "description": "Zod DTOs and types shared by the platform API and web packages. Dual CommonJS + ESM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/EnterpriseAppBase.git",
    "directory": "packages/platform-contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./doctor": {
      "import": {
        "types": "./dist/esm/doctor/index.d.ts",
        "default": "./dist/esm/doctor/index.js"
      },
      "require": {
        "types": "./dist/cjs/doctor/index.d.ts",
        "default": "./dist/cjs/doctor/index.js"
      }
    },
    "./telemetry": {
      "import": {
        "types": "./dist/esm/telemetry/index.d.ts",
        "default": "./dist/esm/telemetry/index.js"
      },
      "require": {
        "types": "./dist/cjs/telemetry/index.d.ts",
        "default": "./dist/cjs/telemetry/index.js"
      }
    },
    "./sharing": {
      "import": {
        "types": "./dist/esm/sharing/index.d.ts",
        "default": "./dist/esm/sharing/index.js"
      },
      "require": {
        "types": "./dist/cjs/sharing/index.d.ts",
        "default": "./dist/cjs/sharing/index.js"
      }
    },
    "./identity": {
      "import": {
        "types": "./dist/esm/identity/index.d.ts",
        "default": "./dist/esm/identity/index.js"
      },
      "require": {
        "types": "./dist/cjs/identity/index.d.ts",
        "default": "./dist/cjs/identity/index.js"
      }
    },
    "./settings": {
      "import": {
        "types": "./dist/esm/settings/index.d.ts",
        "default": "./dist/esm/settings/index.js"
      },
      "require": {
        "types": "./dist/cjs/settings/index.d.ts",
        "default": "./dist/cjs/settings/index.js"
      }
    },
    "./credentials": {
      "import": {
        "types": "./dist/esm/credentials/index.d.ts",
        "default": "./dist/esm/credentials/index.js"
      },
      "require": {
        "types": "./dist/cjs/credentials/index.d.ts",
        "default": "./dist/cjs/credentials/index.js"
      }
    },
    "./onboarding": {
      "import": {
        "types": "./dist/esm/onboarding/index.d.ts",
        "default": "./dist/esm/onboarding/index.js"
      },
      "require": {
        "types": "./dist/cjs/onboarding/index.d.ts",
        "default": "./dist/cjs/onboarding/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-dist-stubs.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
