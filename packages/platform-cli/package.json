{
  "name": "@marinoscar/platform-cli",
  "version": "0.0.0",
  "description": "CLI commands and TUI building blocks of the platform (ESM).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/EnterpriseAppBase.git",
    "directory": "packages/platform-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "commander": "^14.0.2",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.18",
    "commander": "^14.0.2",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
