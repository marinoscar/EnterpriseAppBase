  // the package's tsconfig.json. `npm run typecheck` runs it.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false
  },
  "include": ["./**/*", "../../setup.ts", "../../viewport.ts"],
  "exclude": []
}
