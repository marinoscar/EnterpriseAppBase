exports[`the Telemetry Explorer is unchanged > a phone window 1`] = `"<div class="MuiContainer-root css-5kxf0w-MuiContainer-root"><div class="MuiBox-root css-19ok6ro"><div class="MuiStack-root css-sw1t3l-MuiStack-root"><h1 class="MuiTypography-root MuiTypography-h4 css-13h84jw-MuiTypography-root">Telemetry Explorer</h1><a class="MuiButtonBase-root MuiIconButton-root MuiIconButton-sizeMedium css-e095wa-MuiButtonBase-root-MuiIconButton-root" tabindex="0" aria-label="Open Telemetry Dashboard" data-mui-internal-clone-element="true" href="/admin/settings/telemetry/dashboard" data-discover="true"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="MonitorHeartOutlinedIcon"><path d="…"></path><path d="…"></path></svg></a></div><p class="MuiTypography-root MuiTypography-body1 css-1xz17g7-MuiTypography-root">Query traces, logs and metrics with SQL, export the results, and ask the AI assistant for help.</p><div class="MuiStack-root css-7xfzzp-MuiStack-root" role="toolbar" aria-label="Query toolbar"><span aria-label="Run (Ctrl/⌘ + Enter)" class="" data-mui-internal-clone-element="true"><button class="MuiButtonBase-root MuiButton-root MuiButton-contained MuiButton-sizeMedium MuiButton-colorPrimary css-74d805-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button"><span class="MuiButton-icon MuiButton-startIcon css-1lxyhll-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="PlayArrowIcon"><path d="…"></path></svg></span>Run</button></span><button class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeMedium MuiButton-colorPrimary css-1uent87-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button" aria-haspopup="menu"><span class="MuiButton-icon MuiButton-startIcon css-1lxyhll-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="DownloadIcon"><path d="…"></path></svg></span>Export</button><button class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeMedium MuiButton-colorPrimary css-1uent87-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button" aria-haspopup="menu"><span class="MuiButton-icon MuiButton-startIcon css-1lxyhll-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="LibraryBooksOutlinedIcon"><path d="…"></path></svg></span>Starter queries</button><button class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeMedium MuiButton-colorPrimary css-1uent87-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button" aria-haspopup="menu"><span class="MuiButton-icon MuiButton-startIcon css-1lxyhll-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="HistoryIcon"><path d="…"></path></svg></span>History</button><button class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeMedium MuiButton-colorPrimary css-1uent87-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button"><span class="MuiButton-icon MuiButton-startIcon css-1lxyhll-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="TableChartOutlinedIcon"><path d="…"></path></svg></span>Schema</button></div><div class="MuiBox-root css-veus4h"><div class="MuiBox-root css-1fjtzvx"><div class="MuiPaper-root MuiPaper-outlined MuiPaper-rounded css-3yj415-MuiPaper-root"><textarea aria-label="SQL query">SELECT timestamp, service_name, span_name, span_status_message, trace_id FROM opentelemetry_traces WHERE span_status_code = 'STATUS_CODE_ERROR' AND timestamp &gt; now() - INTERVAL '24 hours' ORDER BY timestamp DESC LIMIT 200</textarea></div><p class="MuiTypography-root MuiTypography-body2 css-7ctihp-MuiTypography-root">Run a query to see results here. Pick a starter query to begin.</p></div></div></div></div>"`;

exports[`the Telemetry Explorer is unchanged > desktop, assistant available 1`] = `"<div class="MuiContainer-root css-5kxf0w-MuiContainer-root"><div class="MuiBox-root css-19ok6ro"><div class="MuiStack-root css-sw1t3l-MuiStack-root"><h1 class="MuiTypography-root MuiTypography-h4 css-13h84jw-MuiTypography-root">Telemetry Explorer</h1><a class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeMedium MuiButton-colorPrimary css-1w86s7s-MuiButtonBase-root-MuiButton-root" tabindex="0" href="/admin/settings/telemetry/dashboard" data-discover="true"><span class="MuiButton-icon MuiButton-startIcon css-1lxyhll-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="MonitorHeartOutlinedIcon"><path d="…"></path><path d="…"></path></svg></span>Dashboard</a></div><p class="MuiTypography-root MuiTypography-body1 css-1xz17g7-MuiTypography-root">Query traces, logs and metrics with SQL, export the results, and ask the AI assistant for help.</p><div class="MuiStack-root css-7xfzzp-MuiStack-root" role="toolbar" aria-label="Query toolbar"><span aria-label="Run (Ctrl/⌘ + Enter)" class="" data-mui-internal-clone-element="true"><button class="MuiButtonBase-root MuiButton-root MuiButton-contained MuiButton-sizeMedium MuiButton-colorPrimary css-74d805-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button"><span class="MuiButton-icon MuiButton-startIcon css-1lxyhll-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="PlayArrowIcon"><path d="…"></path></svg></span>Run</button></span><button class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeMedium MuiButton-colorPrimary css-1uent87-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button" aria-haspopup="menu"><span class="MuiButton-icon MuiButton-startIcon css-1lxyh