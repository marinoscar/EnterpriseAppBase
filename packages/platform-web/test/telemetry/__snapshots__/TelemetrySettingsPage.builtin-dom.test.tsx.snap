"><label class="MuiFormLabel-root MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-shrink MuiInputLabel-sizeSmall MuiInputLabel-outlined MuiFormLabel-colorPrimary MuiFormLabel-filled MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-shrink MuiInputLabel-sizeSmall MuiInputLabel-outlined css-hvjq6j-MuiFormLabel-root-MuiInputLabel-root" data-shrink="true" for="_r_t_" id="_r_t_-label">Maximum steps</label><div class="MuiInputBase-root MuiOutlinedInput-root MuiInputBase-colorPrimary MuiInputBase-formControl MuiInputBase-sizeSmall css-quhxjy-MuiInputBase-root-MuiOutlinedInput-root"><input aria-invalid="false" aria-describedby="_r_t_-helper-text" id="_r_t_" min="1" max="20" step="1" inputmode="numeric" class="MuiInputBase-input MuiOutlinedInput-input css-1pzfmz2-MuiInputBase-input-MuiOutlinedInput-input" type="number" value="8"><fieldset aria-hidden="true" class="MuiOutlinedInput-notchedOutline css-18p5xg2-MuiNotchedOutlined-root-MuiOutlinedInput-notchedOutline"><legend class="css-ex8a5f-MuiNotchedOutlined-root"><span>Maximum steps</span></legend></fieldset></div><p class="MuiFormHelperText-root MuiFormHelperText-sizeSmall MuiFormHelperText-contained MuiFormHelperText-filled css-2s8ubb-MuiFormHelperText-root" id="_r_t_-helper-text">Tool calls per question, from 1 to 20. 15 is recommended for investigations.</p></div></div></div></section><hr class="MuiDivider-root MuiDivider-fullWidth css-moyov0-MuiDivider-root"><button class="MuiButtonBase-root Mui-disabled MuiButton-root MuiButton-contained MuiButton-sizeMedium MuiButton-colorPrimary css-74d805-MuiButtonBase-root-MuiButton-root" tabindex="-1" type="submit" disabled="">Save Changes</button></form></div></div>"`;

exports[`the built-in store's settings page is unchanged > a read-only viewer 1`] = `"<div class="MuiContainer-root MuiContainer-maxWidthLg css-5c1adp-MuiContainer-root"><div class="MuiBox-root css-8f57v9"><div class="MuiStack-root css-sw1t3l-MuiStack-root"><h1 class="MuiTypography-root MuiTypography-h4 css-13h84jw-MuiTypography-root">Telemetry</h1><a class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeMedium MuiButton-colorPrimary css-1w86s7s-MuiButtonBase-root-MuiButton-root" tabindex="0" href="/admin/settings/telemetry/dashboard" data-discover="true"><span class="MuiButton-icon MuiButton-startIcon css-1lxyhll-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="MonitorHeartOutlinedIcon"><path d="M20 4H4c-1.1 0-2 .9-2 2v3h2V6h16v3h2V6c0-1.1-.9-2-2-2m0 14H4v-3H2v3c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-3h-2z"></path><path d="M14.89 7.55c-.34-.68-1.45-.68-1.79 0L10 13.76l-1.11-2.21A.988.988 0 0 0 8 11H2v2h5.38l1.72 3.45c.18.34.52.55.9.55s.72-.21.89-.55L14 10.24l1.11 2.21c.17.34.51.55.89.55h6v-2h-5.38z"></path></svg></span>Open dashboard</a></div><p class="MuiTypography-root MuiTypography-body1 css-9ebprp-MuiTypography-root">Turn telemetry collection on, choose how long it is kept, set query limits and configure the AI assistant. (read-only)</p><p class="MuiTypography-root MuiTypography-body2 css-1tty75b-MuiTypography-root">Last updated by admin@example.com on 9/1/2026, 10:00:00 AM</p><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation0 MuiAlert-root MuiAlert-colorInfo MuiAlert-standard css-26377s-MuiPaper-root-MuiAlert-root" role="alert" data-testid="telemetry-read-only-notice" style="--Paper-shadow: none;"><div class="MuiAlert-icon css-vab54s-MuiAlert-icon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeInherit css-1ckov0h-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="InfoOutlinedIcon"><path d="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20, 12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10, 10 0 0,0 12,2M11,17H13V11H11V17Z"></path></svg></div><div class="MuiAlert-message css-zioonp-MuiAlert-message">You can read this configuration but not change it. Saving needs <code>telemetry:write</code>.</div></div><section class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 css-mo54xu-MuiPaper-root" aria-label="Telemetry services" id="telemetry-services" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><h2 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root">Telemetry services</h2><p class="MuiTypography-root MuiTypography-body2 css-956xpl-MuiTypography-root">The containers that store and collect telemetry for this application.</p><div class="MuiBox-root css-1a6n7l1" role="status" aria-live="polite" data-testid="telemetry-services-live"></div><ul class="MuiStack-root css-kffel9-MuiStack-root"><li class="MuiBox-root css-1jxzuzz"><p class="MuiTypography-root MuiTypography-body1 css-11s8ey5-MuiTypography-root">GreptimeDB (telemetry store)</p><div class="MuiChip-root MuiChip-filled MuiChip-sizeSmall MuiChip-colorSuccess css-106f2r9-MuiChip-root"><span class="MuiChip-label css-eccknh-MuiChip-label">Running · healthy</span></div></li><li class="MuiBox-root css-1jxzuzz"><p class="MuiTypography-root MuiTypography-body1 css-11s8ey5-MuiTypography-root">OpenTelemetry collector</p><div class="MuiChip-root MuiChip-filled MuiChip-sizeSmall MuiChip-colorSuccess css-106f2r9-MuiChip-root"><span class="MuiChip-label css-eccknh-MuiChip-label">Running</span></div></li></ul><button class="MuiButtonBase-root MuiButton-root MuiButton-outlined MuiButton-sizeMedium MuiButton-colorPrimary css-8df3cg-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button">Redeploy</button></section><section class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 css-mo54xu-MuiPaper-root" aria-label="Connection" id="telemetry-connection" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><div class="MuiStack-root css-nz951t-MuiStack-root"><h2 class="MuiTypography-root MuiTypography-h6 css-1miy0lu-MuiTypography-root">Connection</h2><div data-testid="telemetry-connection-source" class="MuiChip-root MuiChip-filled MuiChip-sizeSmall MuiChip-colorSuccess css-1dlg8cb-MuiChip-root"><span class="MuiChip-label css-eccknh-MuiChip-label">Saved in admin settings</span></div></div><p class="MuiTypography-root MuiTypography-body2 css-956xpl-MuiTypography-root" data-testid="telemetry-connection-description">How the API reaches GreptimeDB to read telemetry and apply retention. GreptimeDB is deployed with this application, and the Automatic host finds it — leave the host blank. Enter a host only to use an external GreptimeDB. The collector's writer login is managed by the deployment.</p><form class="MuiBox-root css-0" novalidate=""><div class="MuiGrid-root MuiGrid-container MuiGrid-direction-xs-row MuiGrid-spacing-xs-2 css-zjhuaj-MuiGrid-root"><div class="MuiGrid-root MuiGrid-direction-xs-row MuiGrid-grid-xs-12 MuiGrid-grid-sm-12 css-xvszvy-MuiGrid-root"><div class="MuiFormControl-root MuiFormControl-fullWidth MuiTextField-root css-cmpglg-MuiFormControl-root-MuiTextField-root"><label class="MuiFormLabel-root MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-shrink MuiInputLabel-sizeSmall MuiInputLabel-outlined MuiFormLabel-colorPrimary Mui-disabled MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-shrink MuiInputLabel-sizeSmall MuiInputLabel-outlined css-hvjq6j-MuiFormLabel-root-MuiInputLabel-root" data-shrink="true" for="_r_2p_" id="_r_2p_-label">Host</label><div class="MuiInputBase-root MuiOutlinedInput-root MuiInputBase-colorPrimary Mui-disabled MuiInputBase-fullWidth MuiInputBase-formControl MuiInputBase-sizeSmall css-1blp12k-MuiInputBase-root-MuiOutlinedInput-root"><input aria-invalid="false" aria-describedby="_r_2p_-helper-text" disabled="" id="_r_2p_" placeholder="Automatic: greptimedb" autocapitalize="none" spellcheck="false" class="MuiInputBase-input MuiOutlinedInput-input Mui-disabled css-1pzfmz2-MuiInputBase-input-MuiOutlinedInput-input" type="text" value=""><fieldset aria-hidden="true" class="MuiOutlinedInput-notchedOutline css-18p5xg2-MuiNotchedOutlined-root-MuiOutlinedInput-notchedOutline"><legend class="css-ex8a5f-MuiNotchedOutlined-root"><span>Host</span></legend></fieldset></div><p class="MuiFormHelperText-root Mui-disabled MuiFormHelperText-sizeSmall MuiFormHelperText-contained css-2s8ubb-MuiFormHelperText-root" id="_r_2p_-helper-text">Automatic: greptimedb — the GreptimeDB deployed with this application. Set a host only for an external GreptimeDB.</p></div></div></div><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation0 MuiAlert-root MuiAlert-colorInfo MuiAlert-standard css-mxof55-MuiPaper-root-MuiAlert-root" role="alert" data-testid="telemetry-connection-deployment-managed" style="--Paper-shadow: none;"><div class="MuiAlert-icon css-vab54s-MuiAlert-icon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeInherit css-1ckov0h-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="InfoOutlinedIcon"><path d="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20, 12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10, 10 0 0,0 12,2M11,17H13V11H11V17Z"></path></svg></div><div class="MuiAlert-message css-zioonp-MuiAlert-message"><div class="MuiTypography-root MuiTypography-body1 MuiTypography-gutterBottom MuiAlertTitle-root css-5ick94-MuiTypography-root-MuiAlertTitle-root">Managed by the deployment</div>GreptimeDB is deployed with this application. Its address and logins are managed for you — nothing to configure here.<dl class="MuiBox-root css-2xg2ai" data-testid="telemetry-connection-deployment-summary"><div class="MuiBox-root css-1obf64m"><dt class="MuiTypography-root MuiTypography-body2 css-1n8v0zg-MuiTypography-root">Address</dt><dd class="MuiTypography-root MuiTypography-body2 css-1xw62ht-MuiTypography-root">greptimedb:4003</dd></div><div class="MuiBox-root css-1obf64m"><dt class="MuiTypography-root MuiTypography-body2 css-1n8v0zg-MuiTypography-root">Database</dt><dd class="MuiTypography-root MuiTypography-body2 css-1xw62ht-MuiTypography-root">public</dd></div><div class="MuiBox-root css-1obf64m"><dt class="MuiTypography-root MuiTypography-body2 css-1n8v0zg-MuiTypography-root">Reader login</dt><dd class="MuiTypography-root MuiTypography-body2 css-1xw62ht-MuiTypography-root">Provided</dd></div><div class="MuiBox-root css-1obf64m"><dt class="MuiTypography-root MuiTypography-body2 css-1n8v0zg-MuiTypography-root">Admin login</dt><dd class="MuiTypography-root MuiTypography-body2 css-1xw62ht-MuiTypography-root">Provided</dd></div></dl></div></div><div class="MuiStack-root css-5yamzy-MuiStack-root"><button class="MuiButtonBase-root Mui-disabled MuiButton-root MuiButton-outlined MuiButton-sizeMedium MuiButton-colorPrimary css-1blvszr-MuiButtonBase-root-MuiButton-root" tabindex="-1" type="button" disabled="">Test connection</button><button class="MuiButtonBase-root Mui-disabled MuiButton-root MuiButton-contained MuiButton-sizeMedium MuiButton-colorPrimary css-74d805-MuiButtonBase-root-MuiButton-root" tabindex="-1" type="submit" disabled="">Save connection</button></div><p class="MuiTypography-root MuiTypography-body2 css-1jreg6x-MuiTypography-root">Connection last saved by admin@example.com on 9/1/2026, 10:00:00 AM</p></form></section><section class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 css-mo54xu-MuiPaper-root" aria-label="Status" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><h2 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root">Status</h2><div class="MuiStack-root css-oolww1-MuiStack-root"><div class="MuiChip-root MuiChip-filled MuiChip-sizeSmall MuiChip-colorSuccess css-106f2r9-MuiChip-root"><span class="MuiChip-label css-eccknh-MuiChip-label">Configured</span></div><div class="MuiChip-root MuiChip-filled MuiChip-sizeSmall MuiChip-colorSuccess css-106f2r9-MuiChip-root"><span class="MuiChip-label css-eccknh-MuiChip-label">Reachable</span></div></div><dl class="MuiBox-root css-r0bs9z"><dt>Version</dt><dd>PostgreSQL 16.3 GreptimeDB 1.2.1</dd><dt>Database</dt><dd>telemetry</dd><dt>Retention in force</dt><dd>30 days (30days)</dd></dl><div class="MuiBox-root css-16qjq0e"><table class="MuiTable-root css-1xwxv7r-MuiTable-root" aria-label="Telemetry tables"><thead class="MuiTableHead-root css-1a7iywq-MuiTableHead-root"><tr class="MuiTableRow-root MuiTableRow-head css-1xtozoh-MuiTableRow-root"><th class="MuiTableCell-root MuiTableCell-head MuiTableCell-sizeSmall css-g6bqb5-MuiTableCell-root" scope="col">Table</th><th class="MuiTableCell-root MuiTableCell-head MuiTableCell-alignRight MuiTableCell-sizeSmall css-1ais0ar-MuiTableCell-root" scope="col">Rows</th></tr></thead><tbody class="MuiTableBody-root css-gmh7jj-MuiTableBody-root"><tr class="MuiTableRow-root css-1xtozoh-MuiTableRow-root"><td class="MuiTableCell-root MuiTableCell-body MuiTableCell-sizeSmall css-1bp1vf0-MuiTableCell-root">opentelemetry_traces</td><td class="MuiTableCell-root MuiTableCell-body MuiTableCell-alignRight MuiTableCell-sizeSmall css-17j8okc-MuiTableCell-root">12,345</td></tr><tr class="MuiTableRow-root css-1xtozoh-MuiTableRow-root"><td class="MuiTableCell-root MuiTableCell-body MuiTableCell-sizeSmall css-1bp1vf0-MuiTableCell-root">opentelemetry_logs</td><td class="MuiTableCell-root MuiTableCell-body MuiTableCell-alignRight MuiTableCell-sizeSmall css-17j8okc-MuiTableCell-root">678</td></tr></tbody></table></div><div class="MuiBox-root css-1yuhvjn"><button class="MuiButtonBase-root MuiButton-root MuiButton-text MuiButton-sizeSmall MuiButton-colorPrimary css-1ccsd5i-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button">Refresh status</button></div></section><form class="MuiBox-root css-0" novalidate=""><section class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 css-mo54xu-MuiPaper-root" aria-label="Collection" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><h2 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root">Collection</h2><label class="MuiFormControlLabel-root Mui-disabled MuiFormControlLabel-labelPlacementEnd css-19opgx6-MuiFormControlLabel-root"><span class="MuiSwitch-root MuiSwitch-sizeMedium css-rehya9-MuiSwitch-root"><span class="MuiButtonBase-root MuiSwitch-switchBase MuiSwitch-colorPrimary Mui-checked Mui-disabled PrivateSwitchBase-root MuiSwitch-switchBase MuiSwitch-colorPrimary Mui-checked Mui-disabled Mui-checked Mui-disabled css-aqlqb4-MuiButtonBase-root-MuiSwitchBase-root-MuiSwitch-switchBase"><input disabled="" role="switch" aria-label="Collect telemetry" class="PrivateSwitchBase-input MuiSwitch-input css-12xagqm-MuiSwitchBase-root" type="checkbox" checked=""><span class="MuiSwitch-thumb css-1mw77bv-MuiSwitch-thumb"></span></span><span class="MuiSwitch-track css-pm6g3f-MuiSwitch-track"></span></span><span class="MuiTypography-root MuiTypography-body1 MuiFormControlLabel-label Mui-disabled css-rizt0-MuiTypography-root">Collect telemetry</span></label><p class="MuiFormHelperText-root css-r9aic6-MuiFormHelperText-root">Export of traces, logs and metrics starts or stops within seconds on every instance — no restart. Nothing is collected while no telemetry store is configured.</p><div class="MuiBox-root css-b5i6a0"><div class="MuiFormControl-root MuiFormControl-fullWidth MuiTextField-root css-cmpglg-MuiFormControl-root-MuiTextField-root"><label class="MuiFormLabel-root MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-sizeSmall MuiInputLabel-outlined MuiFormLabel-colorPrimary Mui-disabled MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-sizeSmall MuiInputLabel-outlined css-1kfabtt-MuiFormLabel-root-MuiInputLabel-root" data-shrink="false" for="_r_2g_" id="_r_2g_-label">Instance identifier</label><div class="MuiInputBase-root MuiOutlinedInput-root MuiInputBase-colorPrimary Mui-disabled MuiInputBase-fullWidth MuiInputBase-formControl MuiInputBase-sizeSmall css-1blp12k-MuiInputBase-root-MuiOutlinedInput-root"><input aria-invalid="false" aria-describedby="_r_2g_-helper-text" disabled="" id="_r_2g_" placeholder="my-app" autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="63" class="MuiInputBase-input MuiOutlinedInput-input Mui-disabled css-1pzfmz2-MuiInputBase-input-MuiOutlinedInput-input" type="text" value=""><fieldset aria-hidden="true" class="MuiOutlinedInput-notchedOutline css-18p5xg2-MuiNotchedOutlined-root-MuiOutlinedInput-notchedOutline"><legend class="css-1n64csd-MuiNotchedOutlined-root"><span>Instance identifier</span></legend></fieldset></div><p class="MuiFormHelperText-root Mui-disabled MuiFormHelperText-sizeSmall MuiFormHelperText-contained css-2s8ubb-MuiFormHelperText-root" id="_r_2g_-helper-text">Labels every trace, log and metric as <code>app.instance.id</code> so dashboards can filter and aggregate across deployments that share a telemetry store. Leave blank to use the default, <code>my-app</code>. Currently in use: <code data-testid="telemetry-instance-id-effective">my-app</code>.</p></div></div></section><section class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 css-mo54xu-MuiPaper-root" aria-label="Retention" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><h2 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root">Retention</h2><div role="group" class="MuiToggleButtonGroup-root MuiToggleButtonGroup-horizontal css-1fe81xt-MuiToggleButtonGroup-root" aria-label="Retention period"><button class="MuiButtonBase-root Mui-disabled MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButton-root Mui-disabled MuiToggleButton-sizeSmall MuiToggleButton-standard MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButtonGroup-firstButton css-qofxz1-MuiButtonBase-root-MuiToggleButton-root" tabindex="-1" type="button" disabled="" value="7" aria-pressed="false" aria-label="7 days">7 days</button><button class="MuiButtonBase-root Mui-disabled MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButton-root Mui-selected Mui-disabled MuiToggleButton-sizeSmall MuiToggleButton-standard MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButtonGroup-middleButton css-qofxz1-MuiButtonBase-root-MuiToggleButton-root" tabindex="-1" type="button" disabled="" value="30" aria-pressed="true" aria-label="30 days">30 days</button><button class="MuiButtonBase-root Mui-disabled MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButton-root Mui-disabled MuiToggleButton-sizeSmall MuiToggleButton-standard MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButtonGroup-middleButton css-qofxz1-MuiButtonBase-root-MuiToggleButton-root" tabindex="-1" type="button" disabled="" value="90" aria-pressed="false" aria-label="90 days">90 days</button><button class="MuiButtonBase-root Mui-disabled MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButton-root Mui-disabled MuiToggleButton-sizeSmall MuiToggleButton-standard MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButtonGroup-middleButton css-qofxz1-MuiButtonBase-root-MuiToggleButton-root" tabindex="-1" type="button" disabled="" value="180" aria-pressed="false" aria-label="180 days">180 days</button><button class="MuiButtonBase-root Mui-disabled MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButton-root Mui-disabled MuiToggleButton-sizeSmall MuiToggleButton-standard MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButtonGroup-middleButton css-qofxz1-MuiButtonBase-root-MuiToggleButton-root" tabindex="-1" type="button" disabled="" value="365" aria-pressed="false" aria-label="365 days">365 days</button><button class="MuiButtonBase-root Mui-disabled MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButton-root Mui-disabled MuiToggleButton-sizeSmall MuiToggleButton-standard MuiToggleButtonGroup-grouped Mui-disabled MuiToggleButtonGroup-lastButton css-qofxz1-MuiButtonBase-root-MuiToggleButton-root" tabindex="-1" type="button" disabled="" value="custom" aria-pressed="false" aria-label="Custom">Custom</button></div><p class="MuiFormHelperText-root css-r9aic6-MuiFormHelperText-root">Retention is applied to the telemetry store by a background job after each save (and re-asserted nightly), so older data is dropped shortly after, not instantly.</p></section><section class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 css-mo54xu-MuiPaper-root" aria-label="Query limits" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><h2 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root">Query limits</h2><div class="MuiStack-root css-w7gobd-MuiStack-root"><div class="MuiFormControl-root MuiTextField-root css-puk54g-MuiFormControl-root-MuiTextField-root"><label class="MuiFormLabel-root MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-shrink MuiInputLabel-sizeSmall MuiInputLabel-outlined MuiFormLabel-colorPrimary Mui-disabled MuiFormLabel-filled MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-shrink MuiInputLabel-sizeSmall MuiInputLabel-outlined css-hvjq6j-MuiFormLabel-root-MuiInputLabel-root" data-shrink="true" for="_r_2h_" id="_r_2h_-label">Maximum rows per query</label><div class="MuiInputBase-root MuiOutlinedInput-root MuiInputBase-colorPrimary Mui-disabled MuiInputBase-formControl MuiInputBase-sizeSmall css-quhxjy-MuiInputBase-root-MuiOutlinedInput-root"><input aria-invalid="false" aria-describedby="_r_2h_-helper-text" disabled="" id="_r_2h_" min="1" max="100000" step="1" inputmode="numeric" class="MuiInputBase-input MuiOutlinedInput-input Mui-disabled css-1pzfmz2-MuiInputBase-input-MuiOutlinedInput-input" type="number" value="10000"><fieldset aria-hidden="true" class="MuiOutlinedInput-notchedOutline css-18p5xg2-MuiNotchedOutlined-root-MuiOutlinedInput-notchedOutline"><legend class="css-ex8a5f-MuiNotchedOutlined-root"><span>Maximum rows per query</span></legend></fieldset></div><p class="MuiFormHelperText-root Mui-disabled MuiFormHelperText-sizeSmall MuiFormHelperText-contained MuiFormHelperText-filled css-2s8ubb-MuiFormHelperText-root" id="_r_2h_-helper-text">From 1 to 100000. Larger results are truncated.</p></div><div class="MuiFormControl-root MuiTextField-root css-puk54g-MuiFormControl-root-MuiTextField-root"><label class="MuiFormLabel-root MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-shrink MuiInputLabel-sizeSmall MuiInputLabel-outlined MuiFormLabel-colorPrimary Mui-disabled MuiFormLabel-filled MuiInputLabel-root MuiInputLabel-formControl MuiInputLabel-animated MuiInputLabel-shrink MuiInputLabel-sizeSmall MuiInputLabel-outlined css-hvjq6j-MuiFormLabel-root-MuiInputLabel-root" data-shrink="true" for="_r_2i_" id="_r_2i_-label">Query timeout (seconds)</label><div class="MuiInputBase-root MuiOutlinedInput-root MuiInputBase-colorPrimary Mui-disabled MuiInputBase-formControl MuiInputBase-sizeSmall css-quhxjy-MuiInputBase-root-MuiOutlinedInput-root"><input aria-invalid="false" aria-describedby="_r_2i_-helper-text" disabled="" id="_r_2i_" min="1" max="120" step="1" inputmode="numeric"