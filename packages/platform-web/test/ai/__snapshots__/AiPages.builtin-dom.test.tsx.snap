exports[`the AI pages' markup is unchanged > the AI keys page 1`] = `"<div class="MuiContainer-root MuiContainer-maxWidthMd css-u4uvlt-MuiContainer-root"><div class="MuiBox-root css-1offpxk"><h1 class="MuiTypography-root MuiTypography-h4 MuiTypography-gutterBottom css-1it4a80-MuiTypography-root">AI Keys</h1><p class="MuiTypography-root MuiTypography-body1 css-1xz17g7-MuiTypography-root">Your key is encrypted, never shown again, and only used for requests you make. You are billed by the provider.</p><div class="MuiStack-root css-v2woy3-MuiStack-root"><section class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 MuiCard-root css-1j74uew-MuiPaper-root-MuiCard-root" aria-label="OpenAI key" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><div class="MuiCardContent-root css-1lt5qva-MuiCardContent-root"><div class="MuiStack-root css-1sazv7p-MuiStack-root"><div class="MuiBox-root css-0"><h2 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root" id="ai-key-openai-title">OpenAI</h2><div class="MuiStack-root css-1dtqmwz-MuiStack-root"><div class="MuiChip-root MuiChip-filled MuiChip-sizeSmall MuiChip-colorSuccess css-106f2r9-MuiChip-root"><span class="MuiChip-label css-eccknh-MuiChip-label">Verified</span></div><p class="MuiTypography-root MuiTypography-body2 css-m5mhh0-MuiTypography-root">••••wxyz</p><p class="MuiTypography-root MuiTypography-body2 css-7ctihp-MuiTypography-root">verified 9/1/2026, 12:00:00 PM</p></div></div><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation0 MuiAlert-root MuiAlert-colorInfo MuiAlert-standard css-k1p3sh-MuiPaper-root-MuiAlert-root" role="alert" style="--Paper-shadow: none;"><div class="MuiAlert-icon css-vab54s-MuiAlert-icon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeInherit css-1ckov0h-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-te