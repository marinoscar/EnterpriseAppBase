exports[`the identity pages' markup is unchanged > the Access Tokens page 1`] = `"<div class="MuiContainer-root MuiContainer-maxWidthMd css-u4uvlt-MuiContainer-root"><div class="MuiBox-root css-8f57v9"><h1 class="MuiTypography-root MuiTypography-h4 MuiTypography-gutterBottom css-1it4a80-MuiTypography-root">Access Tokens</h1><p class="MuiTypography-root MuiTypography-body1 css-9ebprp-MuiTypography-root">Create and revoke personal access tokens for API and CLI access.</p><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 MuiCard-root css-1j74uew-MuiPaper-root-MuiCard-root" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><div class="MuiCardContent-root css-1lt5qva-MuiCardContent-root"><div class="MuiBox-root css-21y1cj"><div class="MuiBox-root css-0"><h6 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root">Personal Access Tokens</h6><p class="MuiTypography-root MuiTypography-body2 css-956xpl-MuiTypography-root">Create tokens to authenticate API requests without OAuth.</p></div><button class="MuiButtonBase-root MuiButton-root MuiButton-outlined MuiButton-sizeSmall MuiButton-colorPrimary css-wyro15-MuiButtonBase-root-MuiButton-root" tabindex="0" type="button"><span class="MuiButton-icon MuiButton-startIcon css-t70kls-MuiButton-startIcon"><svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium css-1umw9bq-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="AddIcon"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"></path></svg></span>Create Token</button></div><div class="MuiBox-root css-0" data-testid="settings-pats-table"><table class="MuiTable-root css-1xwxv7r-MuiTable-root" aria-label="Personal access tokens"><thead class="MuiTableHead-root css-1a7iywq-MuiTableHead-root"><tr class="MuiTableRow-root MuiTableRow-head css-1xtozoh-MuiTableRow-root"><th class="MuiTableCell-root MuiTableCell-he