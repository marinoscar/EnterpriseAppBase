{
  // The DataTable's suites (issue #897) were moved from the reference app's
  // suite, which compiles without `noUncheckedIndexedAccess`; like test/ai
  // they keep that one relaxation and every other rule of the package's
  // tsconfig.json. `npm run typecheck` runs it.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false
  },
  "include": ["./**/*", "../setup.ts", "../viewport.ts"],
  "exclude": []
}
