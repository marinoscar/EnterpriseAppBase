exports[`the database backup page's markup is unchanged > a read-only viewer 1`] = `"<div class="MuiContainer-root MuiContainer-maxWidthXl css-hhdjsd-MuiContainer-root"><div class="MuiBox-root css-8f57v9"><h1 class="MuiTypography-root MuiTypography-h4 MuiTypography-gutterBottom css-1it4a80-MuiTypography-root">Database Backup</h1><p class="MuiTypography-root MuiTypography-body1 css-1xz17g7-MuiTypography-root">Schedule backups, review what has been taken, and restore the database from one. (read-only)</p><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 css-mo54xu-MuiPaper-root" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><h6 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root">Schedule and retention</h6><form class="MuiBox-root css-0" novalidate=""><label class="MuiFormControlLabel-root Mui-disabled MuiFormControlLabel-labelPlacementEnd css-19opgx6-MuiFormControlLabel-root"><span class="MuiSwitch-root MuiSwitch-sizeMedium css-rehya9-MuiSwitch-root"><span class="MuiButtonBase-root MuiSwitch-switchBase MuiSwitch-colorPrimary Mui-checked Mui-disabled PrivateSwitchBase-root MuiSwitch-switchBase MuiSwitch-colorPrimary Mui-checked Mui-disabled Mui-checked Mui-disabled css-aqlqb4-MuiButtonBase-root-MuiSwitchBase-root-MuiSwitch-switchBase"><input disabled="" role="switch" aria-label="Scheduled backups" class="PrivateSwitchBase-input MuiSwitch-input css-12xagqm-MuiSwitchBase-root" type="checkbox" checked=""><span class="MuiSwitch-thumb css-1mw77bv-MuiSwitch-thumb"></span></span><span class="MuiSwitch-track css-pm6g3f-MuiSwitch-track"></span></span><span class="MuiTypography-root MuiTypography-body1 MuiFormControlLabel-label Mui-disabled css-rizt0-MuiTypography-root">Take a backup on a schedule</span></label><div class="MuiGrid-root MuiGrid-container MuiGrid-direction-xs-row MuiGrid-spacing-xs-2 css-1fx3571-MuiGrid-roo