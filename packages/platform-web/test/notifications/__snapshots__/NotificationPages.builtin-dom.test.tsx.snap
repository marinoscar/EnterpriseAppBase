exports[`the notification pages' markup is unchanged > the web push page, configured and not configured 1`] = `"<div class="MuiContainer-root MuiContainer-maxWidthLg css-5c1adp-MuiContainer-root"><div class="MuiBox-root css-8f57v9"><h1 class="MuiTypography-root MuiTypography-h4 MuiTypography-gutterBottom css-1it4a80-MuiTypography-root">Web Push</h1><p class="MuiTypography-root MuiTypography-body1 css-9ebprp-MuiTypography-root">Generate a VAPID key pair, enable or rotate it, and control whether this deployment can send browser push notifications.</p><section class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 css-srvwji-MuiPaper-root" aria-labelledby="push-enable-heading" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><form class="MuiBox-root css-0" novalidate=""><div class="MuiStack-root css-wubis5-MuiStack-root"><svg class="MuiSvgIcon-root MuiSvgIcon-colorAction MuiSvgIcon-fontSizeMedium css-1ryok51-MuiSvgIcon-root" focusable="false" aria-hidden="true" viewBox="0 0 24 24" data-testid="NotificationsActiveOutlinedIcon"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2m6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5zM7.58 4.08 6.15 2.65C3.75 4.48 2.17 7.3 2.03 10.5h2c.15-2.65 1.51-4.97 3.55-6.42m12.39 6.42h2c-.15-3.2-1.73-6.02-4.12-7.85l-1.42 1.43c2.02 1.45 3.39 3.77 3.54 6.42"></path></svg><h6 class="MuiTypography-root MuiTypography-h6 css-1miy0lu-MuiTypography-root" id="push-enable-heading">Enable web push</h6></div><label class="MuiFormControlLabel-root MuiFormControlLabel-labelPlacementEnd css-19opgx6-MuiFormControlLabel-root"><span class="MuiSwitch-root MuiSwitch-sizeMedium css-rehya9-MuiSwitch-root"><span class="MuiButtonBase-root MuiSwitch-switchBase MuiSwitch-colorPrimary Mui-checked PrivateSwitchBase-root MuiSwitch-switchBase MuiSwitch-colorPrimary Mu