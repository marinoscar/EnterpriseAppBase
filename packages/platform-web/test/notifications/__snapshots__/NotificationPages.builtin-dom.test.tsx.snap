exports[`the notification pages' markup is unchanged > the notifications preferences page 1`] = `"<div class="MuiContainer-root MuiContainer-maxWidthMd css-u4uvlt-MuiContainer-root"><div class="MuiBox-root css-8f57v9"><h1 class="MuiTypography-root MuiTypography-h4 MuiTypography-gutterBottom css-1it4a80-MuiTypography-root">Notifications</h1><p class="MuiTypography-root MuiTypography-body1 css-9ebprp-MuiTypography-root">Choose which events notify you, and whether they arrive by email or in your browser.</p><div class="MuiBox-root css-1i43dhb"><div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 MuiCard-root css-1j74uew-MuiPaper-root-MuiCard-root" style="--Paper-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12);"><div class="MuiCardContent-root css-1lt5qva-MuiCardContent-root"><h6 class="MuiTypography-root MuiTypography-h6 MuiTypography-gutterBottom css-1wmifpn-MuiTypography-root">Notifications</h6><p class="MuiTypography-root MuiTypography-body2 css-956xpl-MuiTypography-root">Choose what reaches you, and how. Changes are saved as you make them.</p><ul class="MuiBox-root css-nos8u6"><li class="MuiBox-root css-0"><div class="MuiBox-root css-1okc93a"><div class="MuiBox-root css-1n92yll"><div class="MuiBox-root css-1qocved"><h3 class="MuiTypography-root MuiTypography-subtitle1 css-1i3tsf3-MuiTypography-root">Welcome</h3></div><p class="MuiTypography-root MuiTypography-body2 css-7ctihp-MuiTypography-root" id="_rX_-user.welcome-description">Sent once, the first time you sign in to this application.</p></div><div class="MuiBox-root css-2mppj3"><div class="MuiBox-root css-1lxwves"><label class="MuiFormControlLabel-root MuiFormControlLabel-labelPlacementEnd css-1gyrjf2-MuiFormControlLabel-root"><span class="MuiSwitch-root MuiSwitch-sizeMedium css-rehya9-MuiSwitch-root"><span class="MuiButtonBase-root MuiSwitch-switchBase MuiSwitch-colorPrimary Mui-checked PrivateSwitchBase-root MuiSwitch-swit