{
  // Typecheck config (`npm run typecheck` = tsc --noEmit). It covers src/ AND
  // the tests (src/**/*.test.* and test/) and vitest.config.ts, which is why `rootDir`/`outDir` live only
  // in tsconfig.build.json (a rootDir of ./src would make tsc reject the
  // config file with TS6059) - the same split as apps/cli.
  //
  // NodeNext (from tsconfig.base.json) plus `"type": "module"` makes this a
  // real ESM package: every relative import in src/ carries a `.js`
  // extension. Node's ESM loader does no extension guessing, so a missing one
  // typechecks and then fails with ERR_MODULE_NOT_FOUND in a consumer.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // No `node` types: this package runs in a browser. vitest.config.ts brings
    // its own types through its import.
    "types": [],
    // The automatic runtime (`react/jsx-runtime`), as apps/web and apps/cli.
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "test/telemetry", "test/notifications", "test/ai", "test/settings/ui", "test/datatable"]
}
