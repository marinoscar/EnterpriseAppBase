{
  "name": "compose",
  "networks": {
    "app-network": {
      "driver": "bridge",
      "ipam": {},
      "name": "compose_app-network"
    },
    "devnet": {
      "external": true,
      "ipam": {},
      "name": "devnet"
    }
  },
  "services": {
    "api": {
      "build": {
        "context": "<ROOT>",
        "dockerfile": "apps/api/Dockerfile",
        "target": "production"
      },
      "command": null,
      "deploy": {
        "placement": {},
        "resources": {
          "limits": {
            "memory": "536870912"
          }
        }
      },
      "entrypoint": null,
      "environment": {
        "JWT_ACCESS_TTL_MINUTES": "15",
        "JWT_REFRESH_TTL_DAYS": "14",
        "LOG_LEVEL": "info",
        "NODE_ENV": "production",
        "OTEL_ENABLED": "false",
        "OTEL_SERVICE_NAME": "my-app-api",
        "PORT": "3000",
        "POSTGRES_DB": "appdb",
        "POSTGRES_HOST": "db",
        "POSTGRES_PASSWORD": "postgres",
        "POSTGRES_PORT": "5432",
        "POSTGRES_SSL": "false",
        "POSTGRES_USER": "app"
      },
      "networks": {
        "app-network": null,
        "devnet": null
      },
      "restart": "unless-stopped",
      "ulimits": {
        "nofile": {
          "hard": 65536,
          "soft": 65536
        }
      }
    },
    "nginx": {
      "command": null,
      "depends_on": {
        "api": {
          "condition": "service_started",
          "required": true
        },
        "web": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "nginx:1.30-alpine",
      "networks": {
        "app-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3535",
          "target": 80
        }
      ],
      "restart": "unless-stopped",
      "ulimits": {
        "nofile": {
          "hard": 65536,
          "soft": 65536
        }
      },
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/infra/nginx/nginx.conf",
          "target": "/etc/nginx/nginx.conf",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/infra/nginx/csp.conf",
          "target": "/etc/nginx/csp.conf",
          "type": "bind"
        }
      ]
    },
    "web": {
      "build": {
        "context": "<ROOT>",
        "dockerfile": "apps/web/Dockerfile",
        "target": "production"
      },
      "command": null,
      "deploy": {
        "placement": {},
        "resources": {
          "limits": {
            "memory": "134217728"
          }
        }
      },
      "entrypoint": null,
      "networks": {
        "app-network": null
      },
      "restart": "unless-stopped"
    }
  }
}
