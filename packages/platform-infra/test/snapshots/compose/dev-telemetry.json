{
  "name": "compose",
  "networks": {
    "app-network": {
      "driver": "bridge",
      "ipam": {},
      "name": "compose_app-network"
    },
    "devnet": {
      "external": true,
      "ipam": {},
      "name": "devnet"
    }
  },
  "services": {
    "api": {
      "build": {
        "context": "<ROOT>",
        "dockerfile": "apps/api/Dockerfile",
        "target": "development"
      },
      "command": [
        "npm",
        "run",
        "start:dev"
      ],
      "depends_on": {
        "otel-collector": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "GREPTIME_ADMIN_PASSWORD": "snapshot-admin",
        "GREPTIME_ADMIN_USER": "admin",
        "GREPTIME_DB": "public",
        "GREPTIME_HOST": "greptimedb",
        "GREPTIME_PG_PORT": "4003",
        "GREPTIME_READER_PASSWORD": "snapshot-reader",
        "GREPTIME_READER_USER": "reader",
        "JWT_ACCESS_TTL_MINUTES": "15",
        "JWT_REFRESH_TTL_DAYS": "14",
        "LOG_LEVEL": "info",
        "NODE_ENV": "development",
        "OTEL_ENABLED": "true",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4318",
        "OTEL_SERVICE_NAME": "my-app-api",
        "PORT": "3000",
        "POSTGRES_DB": "appdb",
        "POSTGRES_HOST": "db",
        "POSTGRES_PASSWORD": "postgres",
        "POSTGRES_PORT": "5432",
        "POSTGRES_SSL": "false",
        "POSTGRES_USER": "postgres"
      },
      "networks": {
        "app-network": null,
        "devnet": null
      },
      "ulimits": {
        "nofile": {
          "hard": 65536,
          "soft": 65536
        }
      },
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/apps/api/src",
          "target": "/app/apps/api/src",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/apps/api/prisma",
          "target": "/app/apps/api/prisma",
          "type": "bind"
        }
      ]
    },
    "greptimedb": {
      "command": [
        "standalone",
        "start",
        "--http-addr=0.0.0.0:4000",
        "--rpc-bind-addr=0.0.0.0:4001",
        "--mysql-addr=0.0.0.0:4002",
        "--postgres-addr=0.0.0.0:4003",
        "--user-provider=static_user_provider:cmd:admin=snapshot-admin,writer=snapshot-writer,reader:readonly=snapshot-reader"
      ],
      "deploy": {
        "placement": {},
        "resources": {
          "limits": {
            "memory": "1073741824"
          }
        }
      },
      "entrypoint": null,
      "environment": {
        "GREPTIMEDB_STANDALONE__ENABLE_TELEMETRY": "false"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 12,
        "start_period": "10s",
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://localhost:4000/health"
        ],
        "timeout": "5s"
      },
      "image": "greptime/greptimedb:v1.2.1",
      "networks": {
        "app-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "14000",
          "target": 4000
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "14003",
          "target": 4003
        }
      ],
      "volumes": [
        {
          "source": "greptimedb-data",
          "target": "/greptimedb_data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "nginx": {
      "command": null,
      "depends_on": {
        "api": {
          "condition": "service_started",
          "required": true
        },
        "web": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "image": "nginx:1.30-alpine",
      "networks": {
        "app-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3535",
          "target": 80
        }
      ],
      "ulimits": {
        "nofile": {
          "hard": 65536,
          "soft": 65536
        }
      },
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/infra/nginx/nginx.conf",
          "target": "/etc/nginx/nginx.conf",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/infra/nginx/csp.dev.conf",
          "target": "/etc/nginx/csp.conf",
          "type": "bind"
        }
      ]
    },
    "otel-collector": {
      "command": [
        "--config=/etc/otelcol/platform.yaml",
        "--config=/etc/otelcol/app.yaml"
      ],
      "depends_on": {
        "greptimedb": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "GREPTIME_DB": "public",
        "GREPTIME_WRITER_PASSWORD": "snapshot-writer",
        "GREPTIME_WRITER_USER": "writer",
        "POSTGRES_DB": "appdb",
        "POSTGRES_HOST": "db",
        "POSTGRES_MONITOR_PASSWORD": "postgres",
        "POSTGRES_MONITOR_USER": "postgres",
        "POSTGRES_PORT": "5432",
        "POSTGRES_SSL": "false",
        "POSTGRES_TLS_INSECURE_WHEN_SSL_true": "false",
        "UPTIME_PUBLIC_URL": "http://nginx/nginx-health"
      },
      "image": "otel/opentelemetry-collector-contrib:0.145.0",
      "networks": {
        "app-network": null,
        "devnet": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "4327",
          "target": 4317
        },
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "4328",
          "target": 4318
        }
      ],
      "tmpfs": [
        "/hostfs/run:size=1m,mode=0555"
      ],
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/infra/otel/otel-collector-config.yaml",
          "target": "/etc/otelcol/platform.yaml",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/infra/otel/app-collector.yaml",
          "target": "/etc/otelcol/app.yaml",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "/",
          "target": "/hostfs",
          "type": "bind"
        }
      ]
    },
    "web": {
      "build": {
        "context": "<ROOT>",
        "dockerfile": "apps/web/Dockerfile",
        "target": "development"
      },
      "command": [
        "npm",
        "run",
        "dev"
      ],
      "entrypoint": null,
      "environment": {
        "NODE_ENV": "development"
      },
      "networks": {
        "app-network": null
      },
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "<ROOT>/apps/web/src",
          "target": "/app/apps/web/src",
          "type": "bind"
        }
      ]
    }
  },
  "volumes": {
    "greptimedb-data": {
      "name": "compose_greptimedb-data"
    }
  }
}
