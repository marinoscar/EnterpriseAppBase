# =============================================================================
# Worker node environment  (issue #278, epic #254)
# =============================================================================
# Copy to `.env.worker` beside worker.compose.yml and fill in the two required
# values:
#
#   cp .env.worker.example .env.worker
#   docker compose --env-file .env.worker -f worker.compose.yml up -d
#
# Only @@PLATFORM_ENV_PREFIX@@SERVER_URL and @@PLATFORM_ENV_PREFIX@@TOKEN are required. With those two set and
# no config file, the worker synthesises everything else and starts.
#
# NOTE: this file is NOT read by the deploy wizard — that reads .env.example
# beside it, and the two are deliberately separate: a worker runs on different
# machines from the application and shares none of its settings.
# =============================================================================

# The published worker image. Replace OWNER/REPO with your own.
WORKER_IMAGE=@@PLATFORM_WORKER_IMAGE@@

# ---- Required ----------------------------------------------------------------

# The application, as a human would type it — not the /api root.
@@PLATFORM_ENV_PREFIX@@SERVER_URL=https://app.example.com

# A node credential from `@@PLATFORM_CLI_NAME@@ node enroll`. Starts with `nod_`.
# A personal access token also works but carries your full account authority.
@@PLATFORM_ENV_PREFIX@@TOKEN=

# ---- Identity ----------------------------------------------------------------
# LEAVE BOTH EMPTY WHEN SCALING. Setting either makes every replica reattach to
# the same node row, and the server's per-node claim cap is then shared between
# processes that each think they own it.

@@PLATFORM_ENV_PREFIX@@NODE_ID=
@@PLATFORM_ENV_PREFIX@@NODE_NAME=

# ---- Work --------------------------------------------------------------------

# Jobs at once, 1-64. Empty means a core- and RAM-aware default.
@@PLATFORM_ENV_PREFIX@@CONCURRENCY=

# Comma-separated job types. Empty means every type this worker can run.
@@PLATFORM_ENV_PREFIX@@ELIGIBLE_TYPES=

# Idle poll interval in milliseconds. Empty means 5000.
@@PLATFORM_ENV_PREFIX@@POLL_INTERVAL_MS=

# ---- Runtime -----------------------------------------------------------------

# Drain on SIGTERM without deregistering. Always true in a container.
@@PLATFORM_ENV_PREFIX@@HEADLESS=true

# Where the worker keeps its state. Must match the volume mount.
@@PLATFORM_ENV_PREFIX@@STATE_DIR=/var/lib/worker

# ---- Memory ------------------------------------------------------------------

# Old-space limit in MB. Empty means half of RAM, clamped. Zero disables
# re-tuning entirely, which is the right answer under a hard cgroup limit.
@@PLATFORM_ENV_PREFIX@@HEAP_LIMIT_MB=

# Set by the worker on its own re-exec'd child. Never set this by hand.
@@PLATFORM_ENV_PREFIX@@HEAP_TUNED=

# Set to false to disable the memory watchdog and its pre-OOM valve.
@@PLATFORM_ENV_PREFIX@@MEMORY_WATCHDOG=

# heapUsed/heapLimit at which the valve fires. Empty means 0.9.
@@PLATFORM_ENV_PREFIX@@MEMORY_THRESHOLD=

# Set to false to disable all heap-snapshot paths.
@@PLATFORM_ENV_PREFIX@@HEAP_SNAPSHOTS=
