    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "jest --config ./test/jest.config.js --testPathIgnorePatterns='\\.greptime\\.spec\\.ts$' --testPathIgnorePatterns='\\.db\\.spec\\.ts$'",
    "test:run": "jest --config ./test/jest.config.js --ci --testPathIgnorePatterns='\\.greptime\\.spec\\.ts$' --testPathIgnorePatterns='\\.db\\.spec\\.ts$'",
    "test:greptime": "jest --config ./test/jest.config.js --testRegex '\\.greptime\\.spec\\.ts$' --runInBand"
  },
