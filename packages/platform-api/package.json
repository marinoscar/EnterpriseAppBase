{
  "name": "@marinoscar/platform-api",
  "version": "0.1.0-next.0",
  "description": "NestJS dynamic modules of the platform (CommonJS, built with tsc for decorator metadata).",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/EnterpriseAppBase.git",
    "directory": "packages/platform-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./doctor": {
      "types": "./dist/doctor/index.d.ts",
      "default": "./dist/doctor/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/copy-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "jest --config ./test/jest.config.js",
    "test:run": "jest --config ./test/jest.config.js --ci"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/swagger": "^11.2.5",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^7.8.0",
    "fastify": "^5",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/testing": "^11.1.12",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^7.8.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.32",
    "fastify": "^5",
    "jest": "^30.4.2",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
