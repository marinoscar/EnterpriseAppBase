<?xml version="1.0" encoding="utf-8"?>
<!-- The server address, the pairing token and the installation id are device-bound (the token is Keystore-encrypted); never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
