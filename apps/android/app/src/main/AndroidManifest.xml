<?xml version="1.0" encoding="utf-8"?>
<!-- The reference shell: a Trusted Web Activity launcher and a first-run setup screen.
     INTERNET, ACCESS_NETWORK_STATE, POST_NOTIFICATIONS and the Custom Tabs <queries>
     entry come from :platform-core's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        tools:targetApi="36">

        <!-- Trusted Web Activity launcher (a TwaLauncher): opens ${server}/?source=twa&appVersion=…&appVersionCode=…
             (or an incoming https link on the server's host), or the setup screen when no server is set.
             The launcher icon goes through the alias below. -->
        <activity
            android:name=".TwaLauncherActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Launcher">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/twa_default_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand_primary" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand_background" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/brand_background" />
        </activity>

        <!-- The launcher entry. Its component name is ${applicationId}.TwaLauncherActivity, so
             home-screen icons survive an update that moves the Kotlin package. -->
        <activity-alias
            android:name="${applicationId}.TwaLauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".TwaLauncherActivity">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/twa_default_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand_primary" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand_background" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/brand_background" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Web Push delegation: Chrome hands a site's notifications to this app only when the
                 app has a VIEW + BROWSABLE activity for that site's https URLs. ${twaHost} is the host
                 of app.serverUrl at build time; without one it is a host that never matches. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${twaHost}" />
            </intent-filter>

            <!-- The deep link the web app uses to return to the app (`<scheme>://open`). A native
                 capability adds its own host on its own activity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${deepLinkScheme}"
                    android:host="open" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Android 13+: asks for POST_NOTIFICATIONS when the web app requests notification permission
             inside the TWA (androidbrowserhelper's DelegationService hands the browser a PendingIntent
             to this activity). It draws nothing and is not exported. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.App.Invisible" />

        <!-- Lets the web app's notifications and other trusted features be delegated to this app. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notification" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
