{
  "name": "cli",
  "version": "1.0.0",
  "private": true,
  "description": "The reference app's CLI (appctl): @marinoscar/platform-cli composed with this app's identity (epic #110, #715).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "appctl": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace=@marinoscar/platform-infra && npm run build --workspace=@marinoscar/platform-cli && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "docs:worker-env": "tsx scripts/generate-worker-env-table.ts",
    "docs:worker-env:check": "tsx scripts/generate-worker-env-table.ts --check",
    "docs:worker-env:typecheck": "tsc -p scripts/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:ci": "vitest run --coverage --passWithNoTests --reporter=junit --outputFile=junit.xml"
  },
  "dependencies": {
    "@app/shared": "*",
    "@marinoscar/platform-cli": "0.1.0-next.3",
    "commander": "^14.0.2",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
